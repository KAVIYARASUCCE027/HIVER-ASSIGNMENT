# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Which provider adapter to use: "anthropic", "groq", or "gemini".
LLM_PROVIDER=gemini

# Model id (pin an exact version, not a "-latest" alias, for reproducibility).
# Anthropic: claude-sonnet-5 (or claude-haiku-4-5-20251001 for a cheaper/faster option)
# Groq: openai/gpt-oss-120b (or openai/gpt-oss-20b) -- run client.models.list() to see
#   what's actually available/has quota on your account; free-tier daily token limits
#   are low (~200k/day observed) and scoped per-model.
# Gemini: gemini-2.5-flash (or gemini-2.5-pro for a more capable, slower/costlier option)
LLM_MODEL=gemini-3.5-flash-lite

# Anthropic: https://console.anthropic.com -> Settings -> API Keys
# Groq: https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=

# Optional: override the API base URL (rarely needed; Groq's default is
# https://api.groq.com/openai/v1, set automatically if left blank).
# LLM_BASE_URL=
